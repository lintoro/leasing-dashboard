# ==============================================================================
# 商場專櫃營運與招商決策戰情室 - 環境變數範本 (Environment Variables Template)
# 注意：本檔案僅為範本並可提交至 Git，嚴禁將真實密鑰填入此檔案！
# 真實密鑰請於本地建立 .env.local 填寫（已被 .gitignore 嚴格隔離保護）。
# ==============================================================================

# Google Apps Script 網路應用程式 URL (Web App URL)
VITE_GAS_API_URL=https://script.google.com/macros/s/YOUR_DEPLOYMENT_ID/exec

# Google 試算表資料庫 ID (Spreadsheet ID)
VITE_SPREADSHEET_ID=YOUR_GOOGLE_SPREADSHEET_ID

# API 授權金鑰 (需與 GAS 腳本屬性 APP_SHARED_SECRET 一致)
VITE_API_SECRET=your_secure_shared_secret_here
